#!/bin/bash
# Train the 3-channel (og-only) Pico-Algae detector on ITU HPC.
# Writes runs/merged_3ch/checkpoints/best_mae.pt (lowest val count-MAE).
#
# Submit with:
#   sbatch docker/hpc/train_3ch.job
#   sbatch docker/hpc/train_3ch.job --epochs 80        # extra flags pass through
#
# Overrides (env): REPO=, SIF=, INIT_CKPT= (set INIT_CKPT="" to skip warm-start)

#SBATCH --job-name=pico_3ch
#SBATCH --output=pico_3ch_%j.out
#SBATCH --error=pico_3ch_%j.err
#SBATCH --partition=acltr
#SBATCH --gres=gpu:v100:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=1-00:00:00
# acltr = general-access GPU nodes. A TYPED --gres is required or the job sees
# no GPU. v100 (32GB) is plentiful; swap for gpu:a30:1, gpu:a100_40gb:1,
# gpu:l40s:1, gpu:rtx8000:1 ... (see `sinfo -o "%P %G %N"`). Student time cap on
# acltr is 3 days; do NOT exceed it. With Apptainer --nv you do NOT module-load
# CUDA -- the container ships it and --nv passes the driver through.

set -euo pipefail

REPO="${REPO:-$HOME/pico-algae}"
SIF="${SIF:-/opt/itu/containers/pytorchtransformers/pytorch-24.07-py3-transformers.sif}"
DS="$REPO/data/processed/dataset_merged"
INIT_CKPT="${INIT_CKPT-$REPO/runs/tuning/train/best_train_model.pt}"

[ -e "$SIF" ]          || { echo "SIF not found: $SIF"                         >&2; exit 1; }
[ -f "$DS/index.csv" ] || { echo "index.csv missing (run prepare_index.job)"   >&2; exit 1; }
[ -d "$REPO/src" ]     || { echo "Repo not found at $REPO"                      >&2; exit 1; }

echo "Node : $(hostname)"
echo "Repo : $REPO"
echo "Data : $DS"
echo "Warm : ${INIT_CKPT:-<none>}"
echo
nvidia-smi | head -20
echo

INIT_ARG=""
if [ -n "${INIT_CKPT:-}" ] && [ -f "$INIT_CKPT" ]; then
    INIT_ARG="--init_checkpoint '$INIT_CKPT'"
fi

apptainer exec --nv "$SIF" \
    bash -c "cd '$REPO' && python scripts/train_frcnn.py \
        --index_csv '$DS/index.csv' \
        --out_dir runs/merged_3ch \
        --train_yaml src/configs/train_frcnn.yaml \
        --channels 3 $INIT_ARG $*"

echo
echo "Done. Best checkpoint: $REPO/runs/merged_3ch/checkpoints/best_mae.pt"
echo "NOTE: /home has no backup -- download it (see package_3ch.job) promptly."
