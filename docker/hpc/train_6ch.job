#!/bin/bash
# Train the 6-channel (og+red early-fusion) Pico-Algae detector on ITU HPC.
# Writes runs/merged_6ch/checkpoints/best_mae.pt (lowest val count-MAE).
#
# Submit with:
#   sbatch docker/hpc/train_6ch.job
#   sbatch docker/hpc/train_6ch.job --epochs 80        # extra flags pass through
#
# If acltr is booked for days, run on the preemptable queue instead:
#   sbatch --partition=scavenge --gres=gpu:1 docker/hpc/train_6ch.job
# --requeue + --resume (below) make that safe: a preempted job is requeued and
# picks up from the last checkpoint instead of restarting.
#
# Overrides (env): REPO=, SIF=, INIT_CKPT= (set INIT_CKPT="" to skip warm-start)

#SBATCH --job-name=pico_6ch
#SBATCH --output=pico_6ch_%j.out
#SBATCH --error=pico_6ch_%j.err
#SBATCH --partition=acltr
#SBATCH --gres=gpu:v100:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=06:00:00
#SBATCH --requeue
# acltr = general-access GPU nodes. A TYPED --gres is required or the job sees
# no GPU. v100 (32GB) is plentiful; swap for gpu:a30:1, gpu:a100_40gb:1,
# gpu:l40s:1, gpu:rtx8000:1 ... (see `sinfo -o "%P %G %N"`), or override at submit
# with `sbatch --gres=... `. --time is kept SHORT on purpose: a tight limit lets
# the backfill scheduler start you in a gap instead of waiting behind higher-
# priority jobs. 6h covers 60 epochs here; raise it if your node is slow (the
# trainer checkpoints every epoch, so hitting the limit still leaves best_mae.pt).
# With Apptainer --nv you do NOT module-load CUDA -- the container ships it.

set -euo pipefail

# Raise the open-file limit to the hard max (avoids EMFILE from DataLoader shm fds).
ulimit -n "$(ulimit -Hn)" 2>/dev/null || true

REPO="${REPO:-${SLURM_SUBMIT_DIR:-$HOME/pico-algae}}"
SIF="${SIF:-/opt/itu/containers/pytorchtransformers/pytorch-24.07-py3-transformers.sif}"
DS="$REPO/data/processed/dataset_merged"
INIT_CKPT="${INIT_CKPT-$REPO/runs/tuning/train/best_train_model.pt}"

[ -e "$SIF" ]          || { echo "SIF not found: $SIF"                         >&2; exit 1; }
[ -f "$DS/index.csv" ] || { echo "index.csv missing (run prepare_index.job)"   >&2; exit 1; }
[ -d "$REPO/src" ]     || { echo "Repo not found at $REPO"                      >&2; exit 1; }

echo "Node : $(hostname)"
echo "Repo : $REPO"
echo "Data : $DS"
echo "Warm : ${INIT_CKPT:-<none>}"
echo
nvidia-smi | head -20
echo

INIT_ARG=""
if [ -n "${INIT_CKPT:-}" ] && [ -f "$INIT_CKPT" ]; then
    INIT_ARG="--init_checkpoint '$INIT_CKPT'"
fi

apptainer exec --nv "$SIF" \
    bash -c "cd '$REPO' && python scripts/train_frcnn.py \
        --index_csv '$DS/index.csv' \
        --out_dir runs/merged_6ch \
        --train_yaml src/configs/train_frcnn.yaml \
        --channels 6 --resume $INIT_ARG $*"

echo
echo "Done. Best checkpoint: $REPO/runs/merged_6ch/checkpoints/best_mae.pt"
echo "NOTE: /home has no backup -- download results promptly."
